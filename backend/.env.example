DATABASE_URL="postgresql://postgres:postgres@localhost:5434/luviepro?schema=public"
JWT_SECRET="troque-por-um-segredo-forte"
PORT=3333
# Quantidade de proxies reversos confiáveis entre o cliente e a API (0 no acesso direto; normalmente 1 com Nginx)
TRUST_PROXY_HOPS=0
# Em produção, informe somente as origens públicas autorizadas, separadas por vírgula
CORS_ORIGINS="http://localhost:8081"
REDIS_HOST="localhost"
REDIS_PORT="6380"
REDIS_DB="0"
REDIS_KEY_PREFIX="luviepro:dev:"

JWT_REFRESH_SECRET=troque-por-um-segredo-longo-e-diferente

# Convites de usuários
APP_WEB_URL="http://localhost:8081"
INVITATION_TTL_HOURS="48"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LuviePro <no-reply@luviepro.local>"

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
# HTTPS público, por exemplo: https://api.seudominio.com/api/billing/webhooks/mercado-pago
MERCADO_PAGO_WEBHOOK_URL=""
MERCADO_PAGO_USE_SANDBOX="true"

# Apenas para desenvolvimento local/sandbox sem assinatura configurada
MERCADO_PAGO_ALLOW_UNSIGNED_WEBHOOKS="false"
