generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id String @id @default(cuid())
  name String
  slug String @unique
  primaryColor String @default("#2F4538")
  secondaryColor String @default("#C9A84C")
  responsibleName String?
  phone String?
  contactEmail String?
  logoUrl String?
  organizerPhotoUrl String?
  siteUrl String?
  instagram String?
  proposalText String?
  legalName String?
  document String?
  stateRegistration String?
  municipalRegistration String?
  zipCode String?
  addressLine String?
  addressNumber String?
  addressComplement String?
  neighborhood String?
  city String?
  state String?
  proposalValidityDays Int @default(30)
  proposalPaymentTerms String?
  proposalFooter String?
  pixKey String?
  plan String @default("starter")
  planPeriod String?
  subscriptionExpiresAt DateTime?
  status String @default("active")
  createdAt DateTime @default(now())
  users User[]
  clients Client[]
  services Service[]
  quotes Quote[]
  projects Project[]
  subscriptions Subscription[]
  auditLogs AuditLog[]
}
model PlanLimit {
  plan String @id
  maxClients Int
  maxQuotesPerMonth Int
  maxUsers Int
  customPdf Boolean @default(false)
  logoPdf Boolean @default(true)
  premiumTemplates Boolean @default(false)
  projectManagement String @default("basic")
  advancedReports Boolean @default(false)
  exportData Boolean @default(false)
  monthlyPriceCents Int
  quarterlyPriceCents Int
  semiannualPriceCents Int
  annualPriceCents Int
}
model Subscription {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan String
  period String
  amountCents Int
  status String @default("active")
  startsAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([tenantId, status])
}
model User {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  email String @unique
  passwordHash String
  role String @default("admin")
  refreshTokenHash String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Client {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type String @default("individual")
  name String
  legalName String?
  document String?
  stateRegistration String?
  municipalRegistration String?
  contactName String?
  phone String?
  whatsapp String?
  email String?
  zipCode String?
  addressLine String?
  addressNumber String?
  addressComplement String?
  neighborhood String?
  city String?
  state String?
  address String?
  notes String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  quotes Quote[]
  projects Project[]
  @@index([tenantId, name])
  @@index([tenantId, document])
}
model Service {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  code String?
  description String?
  category String?
  billingUnit String @default("daily")
  dailyRateCents Int
  defaultDays Int @default(1)
  people Int @default(1)
  variableCostCents Int @default(0)
  fixedCostCents Int @default(0)
  safetyMarginBps Int @default(2000)
  active Boolean @default(true)
  team ServiceTeamMember[]
  costs ServiceCost[]
  stages ServiceStage[]
  @@index([tenantId, name])
  @@unique([tenantId, code])
}
model ServiceTeamMember {
  id String @id @default(cuid())
  tenantId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  role String
  dailyRateCents Int
  included Boolean @default(true)
  @@index([tenantId, serviceId])
}
model ServiceCost {
  id String @id @default(cuid())
  tenantId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type String
  description String
  amountCents Int
  @@index([tenantId, serviceId])
}
model ServiceStage {
  id String @id @default(cuid())
  tenantId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sequence Int
  description String
  duration String?
  @@unique([serviceId, sequence])
  @@index([tenantId, serviceId])
}
model Quote {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  number String
  status String @default("draft")
  totalCents Int
  discountBps Int @default(0)
  finalTotalCents Int @default(0)
  validityDays Int @default(30)
  notes String?
  sentAt DateTime?
  approvedAt DateTime?
  validUntil DateTime?
  publicToken String? @unique
  publicSharedAt DateTime?
  clientDecision String?
  clientDecisionAt DateTime?
  clientDecisionName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  items QuoteItem[]
  versions QuoteVersion[]
  project Project?
  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
}
model QuoteItem {
  id String @id @default(cuid())
  tenantId String
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceName String
  days Int
  people Int
  laborCents Int
  variableCents Int
  fixedCents Int
  marginCents Int
  totalCents Int
  configurationJson Json?
  stages QuoteStage[]
  @@index([tenantId, quoteId])
}
model QuoteStage {
  id String @id @default(cuid())
  tenantId String
  quoteItemId String
  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  sequence Int
  description String
  duration String?
  completed Boolean @default(false)
  @@unique([quoteItemId, sequence])
  @@index([tenantId, quoteItemId])
}
model Project {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client Client @relation(fields: [clientId], references: [id])
  quoteId String? @unique
  quote Quote? @relation(fields: [quoteId], references: [id])
  name String
  status String @default("scheduled")
  progress Int @default(0)
  startDate DateTime?
  endDate DateTime?
  notes String?
  tasks ProjectTask[]
  activityNotes ProjectNote[]
  monthlyFollowUps MonthlyFollowUp[]
  @@index([tenantId, status])
}
model MonthlyFollowUp {
  id String @id @default(cuid())
  tenantId String
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month Int
  year Int
  visitDate DateTime?
  present Boolean @default(false)
  notes String?
  @@unique([projectId, month, year])
  @@index([tenantId, projectId])
}

model QuoteSequence {
  id String @id @default(cuid())
  tenantId String
  year Int
  lastNumber Int @default(0)
  @@unique([tenantId, year])
}

model AuditLog {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}


model ProjectTask {
  id String @id @default(cuid())
  tenantId String
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title String
  description String?
  status String @default("pending")
  priority String @default("medium")
  dueDate DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, projectId, status])
}

model ProjectNote {
  id String @id @default(cuid())
  tenantId String
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorUserId String?
  authorName String?
  content String
  createdAt DateTime @default(now())
  @@index([tenantId, projectId, createdAt])
}

model QuoteVersion {
  id String @id @default(cuid())
  tenantId String
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version Int
  snapshot Json
  createdById String?
  createdAt DateTime @default(now())
  @@unique([quoteId, version])
  @@index([tenantId, quoteId, createdAt])
}

model CalendarEvent {
  id String @id @default(cuid())
  tenantId String
  createdById String?
  clientId String?
  projectId String?
  title String
  description String?
  type String @default("appointment")
  startAt DateTime
  endAt DateTime?
  allDay Boolean @default(false)
  location String?
  recurrence String @default("none")
  status String @default("active")
  reminderMinutes Int @default(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, startAt, status])
  @@index([tenantId, projectId])
  @@index([tenantId, clientId])
}

model UserNotification {
  id String @id @default(cuid())
  tenantId String
  userId String
  key String
  type String
  title String
  message String?
  route String?
  entityId String?
  readAt DateTime?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, key])
  @@index([tenantId, userId, archivedAt, createdAt])
  @@index([tenantId, userId, readAt])
}

model NotificationPreference {
  id String @id @default(cuid())
  tenantId String
  userId String @unique
  agendaReminders Boolean @default(true)
  projectDeadlines Boolean @default(true)
  quoteExpirations Boolean @default(true)
  taskDeadlines Boolean @default(true)
  emailEnabled Boolean @default(false)
  pushEnabled Boolean @default(false)
  reminderMinutes Int @default(60)
  updatedAt DateTime @updatedAt
  @@index([tenantId, userId])
}
