# Referência local/documental. No Render, use render.yaml + Secrets do Dashboard.
NODE_ENV=production
APP_ENV=staging
PORT=10000
TRUST_PROXY_HOPS=1
HTTP_ACCESS_LOG=true

DATABASE_URL=postgresql://...
REDIS_URL=redis://...
REDIS_KEY_PREFIX=luviepro:hml:

APP_WEB_URL=https://luviepro-hml.onrender.com
CORS_ORIGINS=https://luviepro-hml.onrender.com

JWT_SECRET=
JWT_REFRESH_SECRET=

PLATFORM_ADMIN_EMAIL=master@luviepro.local
PLATFORM_ADMIN_NOTIFICATION_EMAIL=contato.luvieorganiza@gmail.com
PLATFORM_ADMIN_PASSWORD=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://luviepro-api-hml.onrender.com/api/billing/webhooks/mercado-pago
MERCADO_PAGO_USE_SANDBOX=true
MERCADO_PAGO_ALLOW_UNSIGNED_WEBHOOKS=false
ALLOW_DIRECT_PLAN_CHANGE=false

AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=none
DEMO_SEED=0

# E-mail no Render/HML via Resend HTTPS (evita bloqueio de portas SMTP no plano Free)
MAIL_PROVIDER=resend
MAIL_FROM_NAME=LuviePro
RESEND_API_KEY=
RESEND_FROM=LuviePro <noreply@seudominio.com>
RESEND_TIMEOUT_MS=15000

# SMTP - fallback/local
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LuviePro <no-reply@seudominio.com>
NOTIFICATION_EMAIL_WORKER_ENABLED=true
NOTIFICATION_EMAIL_WORKER_INTERVAL_MS=300000
