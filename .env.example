TRUST_PROXY_HOPS=0
CORS_ORIGINS="http://localhost:8081"
HTTP_ACCESS_LOG="false"
EXPO_PUBLIC_API_URL="http://localhost:3333/api"
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_URL=""
