{
  "name": "luviepro-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "npm run start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:routes && npm run verify:contracts && npm run test:auth && npm run test:payment-plan && npm run typecheck && npm run export:web",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:contracts": "node scripts/verify-app-contracts.mjs",
    "test:auth": "node scripts/test-auth-flows.mjs",
    "test:payment-plan": "node scripts/test-payment-plan.mjs",
    "test:e2e:web": "node scripts/run-web-e2e.mjs",
    "test:e2e:web:install": "playwright install chromium",
    "config": "expo config --type public",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:production": "npx eas-cli build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "^54.0.37",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "@types/react-dom": "~19.1.9",
    "@playwright/test": "^1.55.0"
  }
}
