# Desenvolvimento local; no celular, o host localhost é substituído automaticamente pelo IP do Metro.
EXPO_PUBLIC_API_URL="http://localhost:3333/api"
EXPO_PUBLIC_API_TIMEOUT_MS="20000"

# Em builds nativas de produção, use obrigatoriamente uma URL HTTPS pública, por exemplo:
# EXPO_PUBLIC_API_URL="https://api.luviepro.com.br/api"
