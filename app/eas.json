{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT_MS": "90000",
        "EXPO_PUBLIC_API_URL": "https://luviepro-api-hml.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT_MS": "20000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
